# Copy to .env and fill in. On cPanel, set these in the Python App panel instead.

# Flask
FLASK_CONFIG=development
SECRET_KEY=generate-a-long-random-string

# MySQL (SymbolHost cPanel)
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_mc_leads

# Optional: full URL overrides the discrete DB_* vars above
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/dbname?charset=utf8mb4

# Pagination
LEADS_PER_PAGE=20

# Meta (Facebook) Conversions API — leave META_ENABLED=False to disable entirely
META_ENABLED=False
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Optional: routes events to Meta's Test Events tool without affecting live metrics
META_TEST_EVENT_CODE=
