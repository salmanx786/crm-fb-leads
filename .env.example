# Copy to .env and fill in. On cPanel, set these in the Python App panel instead.

# Flask
FLASK_CONFIG=development
SECRET_KEY=generate-a-long-random-string

# Database — the app reads DATABASE_URL only. Point it at your Postgres
# (Supabase). Supabase's direct host (db.<ref>.supabase.co) is IPv6-only, so on
# IPv4-only shared hosting use the Session pooler host shown here. SSL required.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Pagination
LEADS_PER_PAGE=20

# Timezone for CRM display and date windowing (default: Asia/Karachi, PKT)
TIMEZONE=Asia/Karachi

# Meta (Facebook) Conversions API — leave META_ENABLED=False to disable entirely
META_ENABLED=False
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Optional: routes events to Meta's Test Events tool without affecting live metrics
META_TEST_EVENT_CODE=
# 2-letter country hashed into user_data for match quality (default pk). Clear for multi-country.
META_DEFAULT_COUNTRY=pk
# Optional: absolute landing-page URL, sent as event_source_url (e.g. https://mccollege.edu.pk/)
META_EVENT_SOURCE_URL=
